<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Miuix renders its own UI, so the Android theme
         only needs to be a no-action-bar platform theme (no AppCompat/Material
         support library required). minSdk is 23, so windowLightStatusBar is
         always available. -->
    <style name="Theme.Ananbox" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
